APP_RELEASE = "1.12.4-r1"
SCANPY_VERSION = "1.12.4"
CATALOG_PATH = Path(
    os.environ.get(
        "TAFFISH_SCANPY_DATASET_CATALOG",
        "/opt/scanpy/share/scanpy/dataset-catalog.json",
    )
)
CATALOG_SHA256 = "7ec2711c801966b85eafae96857a166a70dbc8921a9094b627d65d9aad5f70fd"
INSTALL_MOUNT = Path("/dataset-install")
DEFAULT_DATASET_ROOT = INSTALL_MOUNT / SCANPY_VERSION
RUNTIME_DATASET_ROOT = Path("/datasets/scanpy")
ROOT_MANIFEST = "TAFFISH_DATASET_MANIFEST.json"
ROOT_INVENTORY = "TAFFISH_DATASET_INVENTORY.tsv"
ROOT_READY = "TAFFISH_DATASET_READY"
CONTROL_DIR = ".taffish"
MEMBER_DIR = "datasets"
INVENTORY_HEADER = "dataset_id\tsha256\tbytes\trelative_path\n"
DATASET_ID = re.compile(r"^[a-z0-9][a-z0-9-]*$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
